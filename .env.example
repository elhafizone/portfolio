# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values you need.
# `.env.local` is gitignored — never commit a real key.
# ---------------------------------------------------------------------------

# CANONICAL DOMAIN — REQUIRED IN PRODUCTION
#
# Feeds canonical tags, hreflang, OpenGraph, the sitemap and robots.txt. It also
# gates indexing: without it the site falls back to https://example.com AND is
# served `noindex` plus `Disallow: /`, deliberately, so a preview or temporary
# host can never outrank the real domain. Set it to go live.
NEXT_PUBLIC_SITE_URL=https://hafizone.dev

# CONTACT FORM DELIVERY
#
# The API route picks a provider by which variables are present:
#   RESEND_API_KEY + CONTACT_TO_EMAIL  -> sends the enquiry as email
#   CONTACT_WEBHOOK_URL                -> POSTs the JSON payload instead
#
# With neither set, the route answers 501 and the form tells the visitor
# plainly that it is not connected. It never fakes a success.

# Where enquiries should land.
CONTACT_TO_EMAIL=hello@hafizone.dev

# Get one at https://resend.com (free tier covers 3,000 emails/month).
# Paste it here, in your own file — not into a chat window.
RESEND_API_KEY=

# The address enquiries are sent FROM. Resend requires the domain to be
# verified by DNS before you can send from it; until then leave this unset and
# the route falls back to Resend's shared `onboarding@resend.dev` sender.
# CONTACT_FROM_EMAIL=noreply@hafizone.dev

# Alternative to Resend: POST the enquiry to Zapier / Make / n8n instead.
# CONTACT_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# ANALYTICS — nothing loads unless this is set.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_ANALYTICS_ID=
